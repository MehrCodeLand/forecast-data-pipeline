# Copy this file to .env and fill in your values. .env is gitignored so
# your secrets are never committed.

# OpenWeather API key. When set, snapshots are collected from OpenWeather
# (richer weather + air pollution). Leave empty to use the keyless
# Open-Meteo source instead. Get a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Minutes between collection runs (optional; default 60)
FETCH_INTERVAL_MINUTES=60
